{
  "name": "tidal-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "generate:days": "node scripts/generate-days.mjs --days=400 --output=src/days.js",
    "verify:days": "node scripts/verify-days.mjs",
    "compose:audio": "python3 scripts/compose-audio.py",
    "test:visual": "node tests/visual.mjs",
    "test:wildlife": "node tests/wildlife-visual.mjs",
    "test:rendering": "node tests/rendering-visual.mjs",
    "test:touch": "node tests/touch-visual.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "lucide": "1.49.0"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "@playwright/test": "1.63.0",
    "pngjs": "7.0.0"
  }
}
